# Пример файла команд для лабораторной 4
# Формат: КОМАНДА аргументы

# Добавить несколько файлов (формат: имя; дата; размер)
ADD income; 28.03.2024; 1200
ADD report; 15.04.2024; 3500
ADD notes; 01.01.2024; 500

# Удалить файлы размером меньше 1000 байт
REM size < 1000

# Сохранить результат в новый файл
SAVE result.txt